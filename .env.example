# --- Bedolaga Bot API ---
# Base URL of the Bedolaga Web API the MCP server talks to.
BEDOLAGA_API_URL=https://your-bot.example.com
# API key for the Bedolaga Web API.
BEDOLAGA_API_KEY=your-api-key-here
# Timeout for Bedolaga API calls, milliseconds (default: 10000).
BEDOLAGA_TIMEOUT_MS=10000

# --- MCP HTTP transport bind ---
# Where the Streamable HTTP server listens inside the container.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3100

# --- REMOVED migration settings ---
# HOST / PORT were the old bind variables. They are REMOVED; the bind is now
# governed by MCP_HTTP_HOST / MCP_HTTP_PORT above. The HTTP launcher keeps a
# temporary compatibility fallback that honors HOST/PORT when the MCP_* vars
# are absent, but you MUST NOT set HOST or PORT for new deployments. Remove
# them from any old .env / service environment.
